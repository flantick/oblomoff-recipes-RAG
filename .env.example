# Copy to .env and adjust if needed.

# Data directories
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Pause between YouTube requests, sec (protection against throttling/bans)
ETL_SLEEP_SECONDS=1.0

# Subtitle languages in priority order
ETL_SUB_LANGS=ru,ru-RU

# Optional HTTP(S) proxy for youtube-transcript-api / yt-dlp, in case YouTube
# starts blocking the IP (a common problem in the cloud / on CI).
# HTTP_PROXY=http://user:pass@host:port
# HTTPS_PROXY=http://user:pass@host:port

# --- Step 3: embeddings + Qdrant ---
EMBED_MODEL=BAAI/bge-m3
EMBED_USE_FP16=1
EMBED_MAX_LENGTH=1024
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=oblomoff_recipes

# --- Steps 4-5: devices, so that everything shares the GPU with vLLM ---
# vLLM (14B-AWQ) takes up almost all of the 16 GB of VRAM, so at runtime the
# embedder and the reranker are kept on the CPU. For bulk indexing
# (src.index.build) it is the other way around: shut vLLM down and set these to
# cuda (or delete the lines).
EMBED_DEVICE=cpu
RERANK_DEVICE=cpu

# --- Step 4: retrieval ---
# A recipe lives in a single video and is stretched over its whole runtime: take
# few videos but go deep. The edges of a video (the greeting, "ставьте лайк")
# are pushed down by a positional weight — that is where the dish name is said
# most often and where there is no recipe.
RETRIEVAL_TOP_VIDEOS=2
RETRIEVAL_PER_VIDEO=6
RETRIEVAL_RERANK_TOP=24
RETRIEVAL_TOKEN_BUDGET=5200
RETRIEVAL_MAX_PASSAGE_WORDS=500
RETRIEVAL_NEIGHBOR_RADIUS=1
RETRIEVAL_FIRST_CHUNK_WEIGHT=0.30
RETRIEVAL_LAST_CHUNK_WEIGHT=0.35

# --- Step 5: LLM behind vLLM (OpenAI-compatible API) ---
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen2.5-14b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# --- ASR (the primary way of obtaining transcripts) ---------------------
# YouTube blocks the subtitle endpoint per IP, so we download the audio and
# transcribe it locally. Requires pot-provider: docker compose up -d pot-provider
ASR_MODEL=large-v3-turbo
# ASR_DEVICE=cuda            # auto by default (cuda when available)
# ASR_COMPUTE_TYPE=float16   # float16 on GPU, int8 on CPU
# ASR_BATCH_SIZE=16          # lower it if VRAM is short
# ASR_LANGUAGE=ru
# ASR_KEEP_AUDIO=1           # keep the downloaded audio (debugging)
# ASR_AUDIO_DIR=data/audio   # a temporary directory by default
